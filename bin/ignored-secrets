#!/usr/bin/env bash
# ignored-secrets <worktree> — print the gitignored files in <worktree> that look like secrets, one
# worktree-relative path per line. Exit 0 = the scan ran (no output = none found) · 2 = it could not scan.
#
# The one list of secret patterns for every delete tool in the fleet: `bin/finish-cleanup` here and
# `108-Ting-Ecosystem/scripts/fleet-sweep.sh` (its worktree pass) both call this file, so a pattern added here
# protects both. Why it exists: `git status` never reports ignored files, so a worktree whose only copy of a
# secret is gitignored looks clean and was deleted whole (2026-11-28: the only flashed ScreenLink board config,
# esp32s3-rs/src/config.rs, went with ~/worktrees/sl-flash-main). Callers must treat exit 2 as "keep it".
#
# `--directory` stops git at an ignored folder; cache folders are skipped by name and every other ignored folder
# is searched with find (caches inside it pruned). Symlinks are not reported: the file they point at lives elsewhere.
set -uo pipefail

w="${1:-}"
[ -n "$w" ] && [ -d "$w" ] || { echo "usage: $0 <worktree>" >&2; exit 2; }
w=$(cd "$w" && pwd -P) || exit 2
git -C "$w" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "$w: not a git work tree" >&2; exit 2; }

CACHE_NAMES=(target node_modules .next build dist out .dart_tool .gradle .venv venv __pycache__ .pytest_cache
  .mypy_cache .ruff_cache .turbo .cache .parcel-cache coverage Pods DerivedData .build .direnv .terraform)

is_cache() { local n; for n in "${CACHE_NAMES[@]}"; do [ "$1" = "$n" ] && return 0; done; return 1; }

is_secret() { # <relative path>
  case "/$1" in */esp32s3-rs/src/config.rs) return 0 ;; esac
  case "${1##*/}" in .secret.key|.env|.env.*|*.pem|*.key|credentials*) return 0 ;; esac
  return 1
}

prune=()
for n in "${CACHE_NAMES[@]}"; do prune+=(-o -name "$n"); done

git -C "$w" ls-files -z --others --ignored --exclude-standard --directory 2>/dev/null |
while IFS= read -r -d '' e; do
  case "$e" in
    */) is_cache "$(basename "$e")" && continue
        find "$w/${e%/}" \( -false "${prune[@]}" \) -prune -o -type f -print 2>/dev/null |
          while IFS= read -r f; do printf '%s\n' "${f#"$w"/}"; done ;;
    *) if [ -f "$w/$e" ] && [ ! -L "$w/$e" ]; then printf '%s\n' "$e"; fi ;;
  esac
done | while IFS= read -r f; do
  if is_secret "$f"; then printf '%s\n' "$f"; fi
done
[ "${PIPESTATUS[0]}" = 0 ] || exit 2
