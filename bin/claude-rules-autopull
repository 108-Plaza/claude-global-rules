#!/bin/bash
# claude-rules-autopull — ดึงกฎกลางล่าสุดแบบอัตโนมัติ (เรียกจาก cron)
#
# ปลอดภัยเป็นหลัก: **fast-forward เท่านั้น** ไม่ rebase ไม่ stash ไม่ commit อะไรเอง
# เครื่องไหนมีของค้างหรือมี commit ที่ยังไม่ push = ข้ามและบันทึกเหตุผล ให้คนมาจัดการ
PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH

REPO="$HOME/.claude/rules-repo"
LIVE="$HOME/.claude/CLAUDE.md"
LOG="$HOME/.claude/rules-sync.log"
LOCK="$HOME/.claude/.rules-sync.lock"

log() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG"; }

# log_every <key> <นาที> <ข้อความ> — เขียนก็ต่อเมื่อคีย์นั้นเงียบมานานพอ
# กันสองอย่าง: heartbeat ไม่ให้ถี่กว่าวันละครั้ง และเหตุผล "ข้าม" ไม่ให้ซ้ำทุก 15 นาที
log_every() {
  local stamp="$HOME/.claude/.rules-sync.stamp-$1" mins="$2" msg="$3"
  if [ -f "$stamp" ] && [ -z "$(find "$stamp" -maxdepth 0 -mmin +"$mins" 2>/dev/null)" ]; then
    return 0
  fi
  log "$msg"
  : > "$stamp"
}

# หมุน log เมื่อเกิน 1 MB
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG" | tr -d ' ')" -gt 1048576 ]; then
  mv "$LOG" "$LOG.1"
fi

# กันรันซ้อน — mkdir เป็น atomic ทั้งบน APFS
if ! mkdir "$LOCK" 2>/dev/null; then
  # ล็อกค้างเกิน 30 นาที = รอบก่อนตายกลางคัน ปลดให้
  if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +30 2>/dev/null)" ]; then
    rmdir "$LOCK" 2>/dev/null && log "ปลดล็อกค้างจากรอบก่อน"
  fi
  exit 0
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT

[ -d "$REPO/.git" ] || { log "ข้าม: ไม่พบ $REPO"; exit 0; }

g() { git -C "$REPO" "$@"; }

# Skills: link every rules-repo/skills/<name> into ~/.claude/skills/ (missing links only; see
# `claude-rules skills`). Runs on every pass, not only after a pull, so a machine already at
# origin still gets skills that arrived before this step existed. Silent when nothing changes.
sync_skills() {
  local out
  [ -x "$REPO/bin/claude-rules" ] || return 0
  out="$("$REPO/bin/claude-rules" skills 2>&1)" || true
  [ -n "$out" ] && log "skills: $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-300)"
  return 0
}

if [ -n "$(g status --porcelain)" ]; then
  log_every dirty 360 "ข้าม: มีของค้างยังไม่ commit ในเวิร์กทรี (ให้คนตัดสินว่าจะ push หรือทิ้ง)"
  exit 0
fi

if ! g fetch -q origin main 2>/dev/null; then
  log_every fetchfail 360 "ข้าม: fetch ไม่ผ่าน (เน็ต/สิทธิ์)"
  exit 0
fi

ahead="$(g rev-list --count origin/main..HEAD 2>/dev/null || echo 0)"
behind="$(g rev-list --count HEAD..origin/main 2>/dev/null || echo 0)"

if [ "$ahead" -gt 0 ]; then
  log_every ahead 360 "ข้าม: เครื่องนี้มี $ahead commit ที่ยังไม่ push — รัน claude-rules push เอง"
  exit 0
fi

if [ "$behind" -eq 0 ]; then
  sync_skills
  # ตรงกันอยู่แล้ว — เขียน heartbeat วันละครั้งพอ (1380 นาที = 23 ชม. กันเลื่อนจนข้ามวัน)
  log_every heartbeat 1380 "heartbeat: ตรงกับ origin ($(g rev-parse --short HEAD)) — ไม่มีอะไรต้องดึง"
  exit 0
fi

before="$(g rev-parse --short HEAD)"
if g merge -q --ff-only origin/main 2>/dev/null; then
  log "อัปเดต: $before -> $(g rev-parse --short HEAD) ($behind commit)"
  : > "$HOME/.claude/.rules-sync.stamp-heartbeat"
  sync_skills
else
  log "🔴 ff-only ไม่ผ่านทั้งที่ ahead=0 — ประวัติถูกเขียนใหม่? ต้องแก้ด้วยมือ: git -C $REPO reset --hard origin/main"
  exit 0
fi

# symlink หลุด = เครื่องนี้เงียบ ๆ ไม่ได้ใช้กฎจาก repo แล้ว
if [ ! -L "$LIVE" ] || [ "$(readlink "$LIVE")" != "$REPO/CLAUDE.md" ]; then
  log "⚠️ $LIVE ไม่ใช่ symlink ของ repo แล้ว — รัน: claude-rules doctor"
fi
