#!/usr/bin/env bash
# claude-rules — ซิงก์ ~/.claude/CLAUDE.md ผ่าน repo 108-Plaza/claude-global-rules
#
#   claude-rules status   เทียบเครื่องนี้กับ origin/main
#   claude-rules pull     ดึงกฎล่าสุดลงเครื่องนี้
#   claude-rules push     ส่งกฎที่แก้ขึ้น origin (rebase ก่อนเสมอ)
#                         โชว์ diff ที่จะขึ้นไปก่อนเสมอ · ต้องยืนยัน (-y/--yes หรือ CLAUDE_RULES_YES=1)
#   claude-rules doctor   ซ่อม symlink ที่ถูกเขียนทับเป็นไฟล์ธรรมดา
#                         and link every skill in rules-repo/skills/ into ~/.claude/skills/
#   claude-rules skills   link the skills only (safe to re-run)
#   claude-rules link     ติดตั้งครั้งแรก: สำรองไฟล์เดิมแล้วทำ symlink
set -euo pipefail

CLONE="$HOME/.claude/rules-repo"
LIVE="$HOME/.claude/CLAUDE.md"
SRC="$CLONE/CLAUDE.md"
REMOTE_HINT="git@github.com:108-Plaza/claude-global-rules.git"

die() { printf 'claude-rules: %s\n' "$1" >&2; exit 1; }
g()   { git -C "$CLONE" "$@"; }
# macOS มี md5 · Linux (Dell) มี md5sum
md5_of() { if command -v md5 >/dev/null 2>&1; then md5 -q "$1"; else md5sum "$1" | cut -d' ' -f1; fi; }

[ -d "$CLONE/.git" ] || die "ยังไม่มีสำเนาที่ $CLONE — โคลนก่อน: git clone $REMOTE_HINT $CLONE"

is_linked() { [ -L "$LIVE" ] && [ "$(readlink "$LIVE")" = "$SRC" ]; }

# Skills: every rules-repo/skills/<name>/SKILL.md is linked as ~/.claude/skills/<name>.
# Only creates missing links and removes links into rules-repo/skills/ whose skill is gone.
# Never touches a real directory or a link that points somewhere else: it reports those instead.
SKILLS_SRC="$CLONE/skills"
SKILLS_LIVE="$HOME/.claude/skills"

link_skills() {
  local src name dst bad=0
  mkdir -p "$SKILLS_LIVE"
  for src in "$SKILLS_SRC"/*/; do
    src="${src%/}"
    [ -f "$src/SKILL.md" ] || continue
    name="${src##*/}"
    dst="$SKILLS_LIVE/$name"
    if [ -L "$dst" ]; then
      if [ "$(readlink "$dst")" = "$src" ]; then continue; fi
      echo "🔴 skill $name: $dst points to $(readlink "$dst"), not $src. Left as is; fix it by hand."
      bad=1
    elif [ -e "$dst" ]; then
      echo "🔴 skill $name: $dst is a real directory, not a link. Left as is; move it aside, then re-run."
      bad=1
    else
      ln -s "$src" "$dst"
      echo "linked skill: $dst -> $src"
    fi
  done
  for dst in "$SKILLS_LIVE"/*; do
    [ -L "$dst" ] || continue
    case "$(readlink "$dst")" in
      "$SKILLS_SRC"/*)
        if [ ! -f "$dst/SKILL.md" ]; then
          rm "$dst"
          echo "removed stale skill link: $dst (its skill is no longer in the repo)"
        fi ;;
    esac
  done
  return "$bad"
}

skills_state() {
  local total=0 linked=0 src
  for src in "$SKILLS_SRC"/*/; do
    src="${src%/}"
    [ -f "$src/SKILL.md" ] || continue
    total=$((total + 1))
    [ -L "$SKILLS_LIVE/${src##*/}" ] && [ "$(readlink "$SKILLS_LIVE/${src##*/}")" = "$src" ] && linked=$((linked + 1))
  done
  if [ "$linked" = "$total" ]; then echo "$linked/$total linked"; else echo "🔴 $linked/$total linked — run: claude-rules skills"; fi
}

link_it() {
  if is_linked; then echo "symlink ถูกต้องอยู่แล้ว"; return 0; fi
  if [ -e "$LIVE" ] && [ ! -L "$LIVE" ]; then
    local bak="$LIVE.bak-$(date +%Y%m%d-%H%M%S)"
    cp "$LIVE" "$bak"
    echo "สำรองไฟล์เดิมไว้: $bak"
  fi
  ln -sfn "$SRC" "$LIVE"
  echo "ทำ symlink แล้ว: $LIVE -> $SRC"
}

cmd_status() {
  local fetched=1
  g fetch -q origin main 2>/dev/null || fetched=0
  local behind ahead dirty
  if [ "$fetched" = 1 ]; then
    behind="$(g rev-list --count HEAD..origin/main 2>/dev/null || echo '?') commit"
    ahead="$(g rev-list --count origin/main..HEAD 2>/dev/null || echo '?') commit"
  else
    # origin ref ที่ถืออยู่เป็นของเก่า — ตัวเลข ahead/behind จะโกหก อย่าโชว์
    behind="เทียบไม่ได้ (fetch ไม่ผ่าน — เครื่องนี้ยังต่อ GitHub ตรงไม่ได้)"
    ahead="$behind"
  fi
  dirty="$(g status --porcelain -- CLAUDE.md)"
  printf '%s\n' "เครื่อง: $(hostname -s)"
  printf '  %-22s %s\n' "md5 ที่ใช้อยู่:" "$(md5_of "$SRC")"
  printf '  %-22s %s\n' "commit:" "$(g log --oneline -1)"
  printf '  %-22s %s\n' "ตามหลัง origin:" "$behind"
  printf '  %-22s %s\n' "นำหน้า origin:" "$ahead"
  if [ -n "$dirty" ]; then
    printf '  %-22s %s\n' "แก้ค้างยังไม่ commit:" "มี ($(g diff --shortstat -- CLAUDE.md | sed 's/^ *//'))"
  else
    printf '  %-22s %s\n' "แก้ค้างยังไม่ commit:" "ไม่มี"
  fi
  if is_linked; then
    printf '  %-22s %s\n' "symlink:" "ปกติ"
  else
    printf '  %-22s %s\n' "symlink:" "🔴 ขาด — รัน: claude-rules doctor"
  fi
  printf '  %-22s %s\n' "skills:" "$(skills_state)"
}

cmd_pull() {
  g fetch -q origin main
  if [ -n "$(g status --porcelain -- CLAUDE.md)" ]; then
    echo "มีกฎที่แก้ค้างอยู่บนเครื่องนี้ — เก็บไว้ชั่วคราวระหว่างดึง (autostash)"
  fi
  if g pull -q --rebase --autostash origin main; then
    echo "ดึงแล้ว: $(g log --oneline -1)"
  else
    die "rebase ชนกัน — แก้ที่ $SRC แล้วรัน: git -C $CLONE rebase --continue"
  fi
  link_it >/dev/null
  echo "md5 ตอนนี้: $(md5_of "$SRC")"
}

# ค้นร่องรอยความลับในบรรทัดที่ "เพิ่มเข้ามา" — เตือนอย่างเดียว ไม่ตัดสินใจแทนคน
SECRET_RE='(TOKEN|SECRET|PASSWORD|PASSWD|API[_-]?KEY|AUTHORIZATION|BEARER)[[:space:]]*[:=][[:space:]]*[^[:space:]"'"'"']{8,}|[0-9a-f]{32,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

# แสดงทุกอย่างที่จะถูก commit ขึ้นไป แล้วขอคำยืนยัน
# เหตุผล: CLAUDE.md เป็นไฟล์เดียวที่ทุก session ในฟลีตเขียนร่วมกันใน worktree เดียว
# `git add CLAUDE.md` จึงสเตจ "ทั้งไฟล์" รวมของที่ session อื่นเพิ่งเขียนค้างไว้ด้วย
# ⇒ ใครกด push ก่อน จะพางานคนอื่นขึ้นไปใต้ข้อความคอมมิตของตัวเอง (เกิดจริง 399c96b, 86aba98)
push_preflight() {
  local diff_body secrets heads
  diff_body="$(g diff HEAD -- CLAUDE.md || true)"
  [ -n "$diff_body" ] || return 0

  echo "──────── สิ่งที่จะขึ้น origin/main ($(g diff HEAD --shortstat -- CLAUDE.md | sed 's/^ *//')) ────────"

  heads="$(printf '%s\n' "$diff_body" | grep -E '^[+-]#{1,3} ' || true)"
  if [ -n "$heads" ]; then
    echo "หัวข้อที่ถูกเพิ่ม/ลบ:"
    printf '%s\n' "$heads" | sed 's/^/    /'
    echo
  fi

  printf '%s\n' "$diff_body" | sed -n '1,200p'
  if [ "$(printf '%s\n' "$diff_body" | wc -l | tr -d ' ')" -gt 200 ]; then
    echo "    … (ตัดที่ 200 บรรทัด · ดูเต็มด้วย: git -C $CLONE diff HEAD -- CLAUDE.md)"
  fi
  echo "─────────────────────────────────────────────────────────────────────"

  secrets="$(printf '%s\n' "$diff_body" | grep '^+' | grep -nEi "$SECRET_RE" || true)"
  if [ -n "$secrets" ]; then
    echo "🔴 บรรทัดที่เพิ่มเข้ามาดูเหมือนมีความลับ — ไฟล์นี้ push ขึ้น GitHub อย่าให้ค่าจริงหลุดขึ้นไป:"
    printf '%s\n' "$secrets" | cut -c1-160 | sed 's/^/    /'
    echo
  fi

  echo "⚠️  ไฟล์นี้ทั้งฟลีตเขียนร่วมกันใน worktree เดียว — บรรทัดข้างบน 'ทั้งหมด' จะขึ้นไป"
  echo "    ใต้ข้อความคอมมิตของคุณ รวมของที่ session อื่นเพิ่งเขียนค้างไว้"
  echo "    ถ้ามีบรรทัดที่ไม่ใช่ของรอบนี้ ให้หยุดแล้วคุยกับ session นั้นก่อน อย่ากด push กลบ"
  echo
}

push_confirm() {
  if [ "${CLAUDE_RULES_YES:-0}" = "1" ] || [ "${ASSUME_YES:-0}" = "1" ]; then
    echo "ยืนยันอัตโนมัติ (CLAUDE_RULES_YES=1) — ข้ามการถาม"
    return 0
  fi
  if [ -t 0 ]; then
    local ans=""
    printf 'ตรวจ diff ข้างบนแล้ว ยืนยัน push? [y/N] '
    read -r ans || true
    case "$ans" in
      y|Y|yes|YES) return 0 ;;
      *) die "ยกเลิก — ยังไม่ commit และยังไม่ push (แก้ค้างยังอยู่ครบที่ $SRC)" ;;
    esac
  fi
  die "ต้องยืนยันก่อน push — อ่าน diff ข้างบนให้จบ แล้วสั่งใหม่: claude-rules push --yes \"ข้อความคอมมิต\"
       (ถ้ามีบรรทัดที่ไม่ใช่ของรอบนี้ อย่าใส่ --yes — ไปคุยกับ session ที่เขียนค้างก่อน)"
}

cmd_push() {
  shift || true          # ทิ้งคำว่า "push"
  local msg="" yes=0 a
  for a in "$@"; do
    case "$a" in
      -y|--yes) yes=1 ;;
      -*) die "ไม่รู้จักตัวเลือก '$a' (มีแค่ -y/--yes)" ;;
      *) [ -n "$msg" ] || msg="$a" ;;
    esac
  done
  [ "$yes" = 1 ] && CLAUDE_RULES_YES=1

  is_linked || echo "⚠️ symlink ขาดอยู่ — จะ push เฉพาะสิ่งที่อยู่ใน $SRC (รัน doctor ก่อนถ้าไม่แน่ใจ)"
  if [ -z "$(g status --porcelain -- CLAUDE.md)" ]; then
    echo "ไม่มีอะไรเปลี่ยนใน CLAUDE.md"
  else
    push_preflight
    push_confirm
    [ -n "$msg" ] || msg="rules: อัปเดตจาก $(hostname -s) $(date '+%Y-%m-%d %H:%M')"
    g add CLAUDE.md
    # ใช้ identity ที่เครื่องตั้งไว้ · ถ้าเครื่องไหนไม่ได้ตั้ง ค่อยใส่ชื่อเครื่องกันไปแปะชื่อคนอื่น
    if [ -n "$(git config --get user.name || true)" ]; then
      g commit -q -m "$msg

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>"
    else
      echo "⚠️ เครื่องนี้ไม่ได้ตั้ง git user.name — ใช้ชื่อเครื่องแทน (ตั้งด้วย git config --global user.name)"
      g -c user.name="$(hostname -s)" -c user.email="support@ibrowe.com" commit -q -m "$msg

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>"
    fi
    echo "commit: $(g log --oneline -1)"
  fi
  g fetch -q origin main
  if ! g rebase -q origin/main; then
    die "กฎบน origin เปลี่ยนและชนกับของเรา — แก้ที่ $SRC แล้ว: git -C $CLONE rebase --continue"
  fi
  g push -q origin HEAD:main
  echo "ส่งขึ้น origin แล้ว: $(g log --oneline -1)"
}

cmd_doctor() {
  link_skills || true
  if is_linked; then echo "symlink ปกติ — ไม่มีอะไรต้องซ่อม"; cmd_status; return 0; fi
  if [ -f "$LIVE" ] && [ ! -L "$LIVE" ]; then
    if cmp -s "$LIVE" "$SRC"; then
      echo "ไฟล์จริงเนื้อหาเท่ากับใน repo — ทำ symlink กลับได้เลย"
    else
      echo "🔴 ไฟล์จริงต่างจาก repo — เครื่องมืออื่นเขียนทับ symlink ไปแล้ว"
      cp "$LIVE" "$SRC"
      echo "   ยกเนื้อหานั้นเข้า repo แล้ว (ยังไม่ commit) — ตรวจด้วย: git -C $CLONE diff"
    fi
  fi
  link_it
}

case "${1:-status}" in
  status) cmd_status ;;
  pull)   cmd_pull ;;
  push)   cmd_push "$@" ;;
  doctor) cmd_doctor ;;
  skills) link_skills ;;
  link)   link_it ;;
  -h|--help|help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "ไม่รู้จักคำสั่ง '$1' (ดู --help)" ;;
esac
